  "layoutLock": {
    "source": "GetGo Web student learning route source and established student shell",
    "immutable": [
      "student application header and navigation",
      "single active-topic header with switch-topic action",
      "quiz-card list that opens the existing quiz action chooser",
      "portrait bottom navigation and landscape desktop navigation",
      "shared 1024px application content boundary"
    ],
    "administratorExceptions": [
      "quiz cards may be redesigned while retaining quiz icon, name, last interaction, attempts, progress, score, and open behavior"
    ]
  },
  "quizCompletionRule": {
    "minimumSubmittedExams": 3,
    "minimumAverageAccuracyPercent": 70,
    "finishedWhen": "submittedExams >= 3 && averageAccuracyPercent >= 70",
    "insufficientAttemptsState": "in-progress",
    "belowPassingAverageState": "practice-more",
    "neverInteractedState": "new"
  },
  "artDirection": {
    "scene": "Theme-neutral storybook garden framing the existing learning page.",
    "styleLock": "Polished watercolor/gouache children's-book illustration; subtle paper texture; rounded clean silhouettes; natural greens, airy cyan, pale cream and restrained yellow; diffuse neutral light; consistent daisies, rounded leaves and learning-path motifs.",
    "assetStrategy": "Reuse the design-level garden header/footer for both orientations and add one shared 3x learning-trail accent.",
    "forbidden": ["layout replacement", "baked UI", "raster text", "sun", "moon", "stars", "night cues", "fake completion"]
  },
  "theme": {
    "canonicalArtwork": "light",
    "darkDerivation": "Reuse identical artwork and geometry, with the shared CSS artwork mask and dark semantic tokens.",
    "darkOverlay": "rgba(0,32,27,.72)",
    "lightDarkGeometryParity": true,
    "lightDarkAssetParity": true
  },
  "tokens": {
    "canvas": { "light": "#effcf5", "dark": "#0d3c33" },
    "minimumTouchTarget": 44,
    "completion": "#00b982",
    "developing": "#f2a91d",
    "practiceMore": "#8769dd"
  },
  "content": {
    "topic": "Hành trình kiến thức",
    "quizCards": [
      "Khám phá chữ cái",
      "Thế giới động vật",
      "Số học 1–100",
      "Nhà khoa học nhí"
    ],
    "requiredSignals": ["quiz icon", "quiz name", "last interaction when available", "submitted exam count when available", "average score when available", "earned completion state", "state-specific next step"],
    "missingDataPresentation": "Omit unavailable metadata, score, and progress UI instead of rendering zero values, dashes, labels, or empty progress tracks.",
    "cardInformationOrder": [
      "quiz icon and name with score percentage aligned right",
      "status tag followed by last interaction when available",
      "natural-language progress summary with completed exam count and average score",
      "state-specific next action"
    ],
    "portraitCardLayout": "Cards use intrinsic content height. Progress and next-action rows span the complete card width and align with the icon's left edge.",
    "cardSeparator": "none",
    "cardClickIndicator": "none",
    "scoreAlignment": "The percentage is vertically centered against the quiz icon."
