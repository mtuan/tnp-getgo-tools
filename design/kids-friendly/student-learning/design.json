{
  "schemaVersion": 2,
  "page": {
    "slug": "student-learning",
    "name": "GetGo: Học tập",
    "route": "/student/learning",
    "purpose": "Choose an assigned quiz and understand recent study progress.",
    "heightBehavior": "vertical-scroll"
  },
  "viewports": {
    "portrait": { "width": 390, "height": 844 },
    "landscape": { "width": 1024, "height": 768 }
