# Shared, non-secret project identifiers are committed in this file. Copy it
# to .env only when adding private values or local path overrides.

# Optional repository overrides. Leave blank to search nearby directories.
GETGO_QUIZZES_ROOT=
GETGO_WEB_ROOT=
GETGO_APP_ROOT=
GETGO_LOGICS_ROOT=

# PRIVATE: create/use a developer-specific key. Never commit the value.
GETGO_AI_OPENAI_API_KEY=
GETGO_AI_OPENAI_MODEL=gpt-5.6-terra

# Firebase Web configuration is public application metadata, not an
# authentication secret. Firebase Security Rules and IAM protect the data.
GETGO_FIREBASE_DEVELOPMENT_PROJECT_ID=tnp-getgo-dev
GETGO_FIREBASE_DEVELOPMENT_PROJECT_NUMBER=228489803923
GETGO_FIREBASE_DEVELOPMENT_API_KEY=
GETGO_FIREBASE_DEVELOPMENT_STORAGE_BUCKET=tnp-getgo-dev.firebasestorage.app
GETGO_FIREBASE_STAGING_PROJECT_ID=tnp-getgo-staging
GETGO_FIREBASE_STAGING_PROJECT_NUMBER=296413485822
GETGO_FIREBASE_STAGING_API_KEY=
GETGO_FIREBASE_STAGING_STORAGE_BUCKET=tnp-getgo-stg.firebasestorage.app
GETGO_FIREBASE_PRODUCTION_PROJECT_ID=tnp-getgo
GETGO_FIREBASE_PRODUCTION_PROJECT_NUMBER=907210425295
GETGO_FIREBASE_PRODUCTION_API_KEY=
GETGO_FIREBASE_PRODUCTION_STORAGE_BUCKET=tnp-getgo.firebasestorage.app

# OAuth client IDs and Meta app IDs are public identifiers.
GETGO_GOOGLE_DESKTOP_CLIENT_ID=907210425295-ldga47cu8kuu7gdeov0rg5utktm7vkoi.apps.googleusercontent.com
GETGO_FACEBOOK_APP_ID=1419619853414924

# PRIVATE: distribute through a password manager, never source control.
GETGO_GOOGLE_DESKTOP_CLIENT_SECRET=
