# Firebase Web app configuration for each backend environment.
# Project IDs are fixed; copy each API key from that project's Firebase web app.
GETGO_FIREBASE_DEVELOPMENT_PROJECT_ID=tnp-getgo-dev
GETGO_FIREBASE_DEVELOPMENT_PROJECT_NUMBER=
GETGO_FIREBASE_DEVELOPMENT_API_KEY=
GETGO_FIREBASE_STAGING_PROJECT_ID=tnp-getgo-staging
GETGO_FIREBASE_STAGING_PROJECT_NUMBER=
GETGO_FIREBASE_STAGING_API_KEY=
GETGO_FIREBASE_PRODUCTION_PROJECT_ID=tnp-getgo
GETGO_FIREBASE_PRODUCTION_PROJECT_NUMBER=907210425295
GETGO_FIREBASE_PRODUCTION_API_KEY=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Desktop client
GETGO_GOOGLE_DESKTOP_CLIENT_ID=
GETGO_GOOGLE_DESKTOP_CLIENT_SECRET=

# Meta for Developers → App settings → App ID
GETGO_FACEBOOK_APP_ID=
